# ============================================
# TradeLeague - Environment Variables
# Copy this to .env and fill in real values
# ============================================

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
# Lightsail: add its static IPv4 here. Add a domain too once you have one.
ALLOWED_HOSTS=your-lightsail-static-ip,your-domain.com
# Use http:// for the IP-only launch, then HTTPS origins once TLS is enabled.
CSRF_TRUSTED_ORIGINS=http://your-lightsail-static-ip,https://your-domain.com
USE_HTTPS=False

# Google OAuth (leave blank until the production HTTPS domain is configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Database
# For the 512 MB Lightsail plan, leave all DB_* values unset: the project uses
# local SQLite, which avoids the cost of a separate RDS database. Back up
# db.sqlite3 with a Lightsail snapshot before upgrades.
# Set the variables below only if you later move to PostgreSQL/RDS.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=tradeleague
# DB_USER=postgres
# DB_PASSWORD=your-rds-password
# DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
# DB_PORT=5432

# Redis is optional. Leave this blank on a single Lightsail server; the
# in-memory channel layer supports the project's WebSockets in one process.
REDIS_URL=

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://your-lightsail-static-ip,https://your-domain.com
